{
  "name": "floofycrew",
  "version": "0.0.0",
  "displayName": "FloofyCrew Loader (unofficial)",
  "description": "Unofficial mod loader for KiroCrew. Not affiliated with Kiro or KiroCrew. Runs the FloofyCrew mods you chose, on your consent, inside the gateway; serves the mod manager page.",
  "author": "FloofyCrew contributors",
  "license": "MIT",
  "tags": [
    "mods",
    "unofficial",
    "floofycrew"
  ],
  "ui": {
    "entry": "index.mjs"
  },
  "backend": {
    "hooks": {
      "routes": "floofy_loader.hooks:register_routes",
      "on_startup": "floofy_loader.hooks:on_startup",
      "on_shutdown": "floofy_loader.hooks:on_shutdown"
    }
  },
  "permissions": {},
  "floofycrew": {
    "unofficial": true,
    "dataHome": "<host home>/floofy",
    "routesMountedAt": "/api/apps/floofycrew",
    "routes": [
      {
        "method": "GET",
        "path": "/state",
        "purpose": "LoaderState JSON (+ api_version, unofficial)"
      },
      {
        "method": "GET",
        "path": "/health",
        "purpose": "Loader liveness"
      },
      {
        "method": "POST",
        "path": "/reload",
        "purpose": "re-run the boot sequence (apply pending/ now)"
      },
      {
        "method": "POST",
        "path": "/mods/{id}/fault",
        "purpose": "SPA host reports a failed module {message, stack, source}"
      },
      {
        "method": "GET",
        "path": "/spa/{id}/{file...}",
        "purpose": "an enabled mod's spa part files (1-4 segments)"
      },
      {
        "method": "POST",
        "path": "/cli",
        "purpose": "run one allowlisted floofy command in-process for the manager UI {argv}"
      },
      {
        "method": "GET",
        "path": "/registry",
        "purpose": "registry cache summary and update availability per installed mod"
      }
    ]
  }
}
