{
  "schema": 1,
  "id": "agent-orchestrator",
  "name": "Agent Orchestrator",
  "version": "0.2.0",
  "description": "Real parallel multi-agent orchestration for KiroCrew: an orchestrator session divides a goal into items, runs one worker session per item at the same time, and coordinates them live over a typed, bounded message bus (hub-and-spoke: every worker reports to the orchestrator, which relays; worker \u21c4 worker is an opt-in setting) with wake-ups, a wait-any primitive and per-worker status lines. Ships the `agent-orchestrator` and `agent-orchestrator-worker` agents (built on the host's session-control and work-ledger tools, which stay untouched) and a live hub-and-spoke graph page with an animated message bus. Unofficial.",
  "authors": [
    "Oscar Tseng"
  ],
  "license": "MIT",
  "tags": [
    "orchestration",
    "multi-agent",
    "parallel",
    "message-bus",
    "conductor",
    "graph",
    "visualization"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.9.0",
