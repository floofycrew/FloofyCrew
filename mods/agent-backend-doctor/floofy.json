{
  "schema": 1,
  "id": "agent-backend-doctor",
  "name": "Agent Backend Doctor",
  "version": "0.2.0",
  "description": "Finds, un-caches and repairs KiroCrew's agent-backend harnesses (Claude Code, Codex, OpenCode, pi). Fills the host's adapter search when an npm global prefix it does not look in (~/.local/node, ~/.npm-global, a ~/.npmrc prefix, $NPM_CONFIG_PREFIX) holds claude-agent-acp / codex-acp / pi-acp; resets the gateway's cached 'not found' so a backend installed after the gateway started works without a restart; keeps a Bedrock-backed Codex's AWS credentials usable inside KiroCrew's sandbox (an isolated 0600 copy of the configured profile's non-secret keys outside ~/.aws, handed to the codex-acp child explicitly, with a launch preflight and a sandboxed provider-chain probe); one page showing per backend what the host sees, what this mod found, the gateway cache state and the advertised models, with an opt-in CODEX_PATH switch (run the codex you installed) and an opt-in symlink repair into ~/.local/bin. Unofficial.",
  "authors": [
    "Oscar Tseng"
  ],
  "license": "MIT",
  "tags": [
    "backend",
    "claude-code",
    "codex",
    "npm",
    "aws",
    "bedrock",
    "diagnostics",
    "repair"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.9.0",
    "editions": [
      "internal",
      "external"
    ],
    "strict": false
  },
  "dependsOn": {
    "floofycrew": "^1.0"
  },
  "network": {
    "hosts": [],
    "credentials": false
  },
