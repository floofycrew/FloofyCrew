{
  "schema": 1,
  "id": "model-retry-policy",
  "name": "Model Retry Policy",
  "version": "0.1.3",
  "description": "Chooses what KiroCrew does when the model or its API fails transiently (throttling, overload, 5xx, dropped stream) instead of the fixed three retries: a retry count of your own, retry forever at a fixed interval, retry forever with exponential backoff, or a fallback profile that moves to other models after N retries (and optionally never gives up on the last). Applies to dashboard chats (including errors that land mid-turn, after text or a tool call has streamed), cron/Slack turns and sub-agents; works alongside Agent Backend Router. Unofficial.",
  "authors": [
    "Oscar Tseng"
  ],
  "license": "MIT",
  "tags": [
    "retry",
    "backoff",
    "fallback",
    "throttling",
    "models"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.9.0",
    "editions": [
      "internal",
      "external"
    ],
    "strict": false
  },
  "dependsOn": {
    "floofycrew": "^1.0"
  },
  "recommends": {
    "agent-backend-router": ">=0.1.0"
  },
  "network": {
    "hosts": [],
    "credentials": false
  },
