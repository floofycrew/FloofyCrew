      "side": "gateway",
      "path": "hook/",
      "module": "hook",
      "early": false
    },
    {
      "kind": "ui",
      "side": "spa",
      "path": "ui/",
      "entry": "ui/page.mjs",
      "title": "Model Retry Policy",
      "icon": "ui/icon.svg"
    }
  ],
