{
  "schema": 1,
  "id": "kiro-spec-plan",
  "name": "Kiro Spec & Plan",
  "version": "0.1.0",
  "description": "Adds Kiro's built-in modes to the agent list \u2014 Spec, Quick Spec, Bug Fix and Plan \u2014 the same structured workflows as Kiro IDE, run by the kiro-cli v3 engine (KAS). Needs agent.acp_backend = kas.",
  "authors": [
    "Oscar Tseng"
  ],
  "license": "MIT",
  "tags": [
    "agent",
    "kiro",
    "spec",
    "plan",
    "workflow"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.9.0",
    "editions": [
      "internal",
      "external"
    ],
    "strict": false
  },
  "dependsOn": {
    "floofycrew": "^1.0"
  },
  "network": {
    "hosts": [],
    "credentials": false
  },
  "parts": [
    {
      "kind": "agent",
      "side": "gateway",
      "path": "agents/spec.json"
    },
    {
      "kind": "agent",
      "side": "gateway",
      "path": "agents/quick-spec.json"
    },
    {
      "kind": "agent",
      "side": "gateway",
      "path": "agents/bug-fix.json"
    },
    {
      "kind": "agent",
      "side": "gateway",
      "path": "agents/plan.json"
    },
    {
      "kind": "python-hook",
      "side": "gateway",
      "path": "hook/",
      "module": "hook",
      "early": false
    },
    {
      "kind": "spa",
      "side": "spa",
      "path": "spa/main.js",
      "activation": "runtime"
    }
  ],
